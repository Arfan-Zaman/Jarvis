# JARVIS configuration example.
# Copy to `.env` and edit. `.env` is git-ignored. Never commit secrets.
# Precedence: real environment variables > .env > built-in defaults.
# Every value below is the built-in default, so an empty .env works.

# --- Runtime ---------------------------------------------------------------
# development | production (informational for now)
JARVIS_ENV=development

# Where the database, logs and backups live. Relative paths are resolved
# against the project root.
JARVIS_DATA_DIR=data

# --- Web interface ---------------------------------------------------------
# JARVIS only accepts loopback addresses (127.0.0.1, localhost, ::1).
# There is no login yet, so it must not be exposed to a network.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO

# --- AI provider -----------------------------------------------------------
# none   - no model connected (default). JARVIS says so plainly.
# ollama - a local Ollama server (must be installed and running separately).
# mlx    - reserved for Apple MLX; not implemented yet.
JARVIS_AI_PROVIDER=none
JARVIS_AI_MODEL=
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_AI_TIMEOUT_SECONDS=120

# External (non-local) AI providers send your data off this machine.
# None are implemented yet; this switch must be true before one can be used.
JARVIS_ALLOW_EXTERNAL_AI=false

# --- Safety ----------------------------------------------------------------
# false puts JARVIS in read-only mode: every create/update/delete is refused.
JARVIS_ALLOW_WRITES=true
# How long a pending approval stays valid.
JARVIS_APPROVAL_TTL_MINUTES=15

# --- Backups ---------------------------------------------------------------
# Take a backup each time the server starts.
JARVIS_BACKUP_ON_START=true
# How many backups to keep (oldest are pruned).
JARVIS_BACKUP_KEEP=14
